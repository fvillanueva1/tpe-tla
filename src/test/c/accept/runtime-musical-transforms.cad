key tonalidad = C major;
chord triada = triad on 2 of tonalidad;
chord septima = seventh on V of tonalidad;
chord novena = ninth on I of tonalidad;
progression grados = [I, V, viidim] in tonalidad;
integer longitud = grados.length;
chord ultimo = grados[2];
progression concatenada = (grados + [{C4}]) + {D4};
progression repetida = [{C4, E4, G4}] * 2;
progression vacia = repetida * 0;
progression transportada = ([I, V] in tonalidad) + M2;
progression descendente = transportada - M2;
chord movido = {C4, E4, G4} + M3;
chord invertido = invert {G4, C4, E4} by 1;
note fundamental = invertido.root;
progression arpegio = arpeggiate {G4, C4, E4} as sixteenth;
key dominante = dominant of tonalidad;
key subdominante = subdominant of tonalidad;
key relativa = relative minor of dominante;
progression modulada = modulate ([I, V] in tonalidad) to A minor;
progression mixta = [triad on I of tonalidad, {C4, E4, G4}];
progression moduladaMixta = modulate mixta to G major;
log "{triada} {septima} {novena}";
log "{grados} {longitud} {ultimo}";
log "{concatenada}";
log "{repetida} {vacia}";
log "{transportada} {descendente}";
log "{movido} {invertido} {fundamental}";
log "{arpegio}";
log "{dominante} {subdominante} {relativa}";
log "{modulada}";
log "{moduladaMixta}";

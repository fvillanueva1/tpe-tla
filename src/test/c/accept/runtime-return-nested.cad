define uno() -> integer { return 1; }
define numeros() -> integer[] { return [uno(), uno() + 1]; }
define negado() -> boolean { return not (numeros()[0] == 1); }
define suma(integer primero, integer segundo) -> integer { return primero + segundo; }
integer[] lista = numeros();
boolean resultado = negado();
integer total = suma(uno(), suma(uno(), uno()));
log "{lista} {resultado} {total}";

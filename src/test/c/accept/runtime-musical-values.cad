note[] notas = [Cb4, B#3, C#4, Db4];
interval[] intervalos = [aug4, d5, P8];
key[] tonalidades = [C major, D dorian, B locrian, F lydian, A minor, G mixolydian, E phrygian];
scale[] escalas = [scale of F major, scale of G major];
chord acorde = {G4, C4, E4};
note raiz = acorde.root;
integer octava = notas[0].octave;
boolean enarmonicas = notas[2] == notas[3];
boolean tritonos = intervalos[0] == intervalos[1];
boolean orden = C4 < C5 and M2 < M3 and C5 >= C5 and P5 != P4;
boolean pertenece = E7 in scale of tonalidades[0];
boolean perteneceAcorde = C7 in acorde;
boolean ajena = F#4 in scale of tonalidades[0];
boolean modo = tonalidades[0].mode == (C major).mode;
boolean calidad = (triad on viidim of tonalidades[0]).quality == diminished;
log "{notas} {intervalos}";
log "{tonalidades}";
log "{escalas}";
log "{acorde} {raiz} {octava}";
log "{enarmonicas} {tritonos} {orden} {pertenece} {perteneceAcorde} {ajena} {modo} {calidad}";
